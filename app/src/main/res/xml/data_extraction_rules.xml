<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Security & Privacy (PRD 06 §3.3): Exclude sensitive local credentials and voice data from cloud backup and device transfer -->
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
